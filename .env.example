# Exchange API Keys (OPTIONAL - NOT NEEDED for DEX-only arbitrage)
# Only required if you have $5k-10k capital for CEX trading
# Leave empty for DEX-only strategy with flash swaps
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=

# Blockchain RPC URLs
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
ETHEREUM_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
POLYGON_RPC_URL=your_polygon_rpc_url
POLYGON_WSS_URL=your_polygon_wss_url
ARBITRUM_RPC_URL=your_arbitrum_rpc_url
ARBITRUM_WSS_URL=your_arbitrum_wss_url
OPTIMISM_RPC_URL=your_optimism_rpc_url
OPTIMISM_WSS_URL=your_optimism_wss_url
BSC_RPC_URL=your_bsc_rpc_url
BSC_WSS_URL=your_bsc_wss_url

# Wallet Configuration
PRIVATE_KEY=your_wallet_private_key
WALLET_ADDRESS=your_wallet_address

# Trading Parameters
MIN_PROFIT_THRESHOLD=0.5

# Separate limits for CEX and DEX (allows different risk profiles)
MAX_TRADE_AMOUNT_CEX=1000      # Maximum trade amount for CEX arbitrage (in USDT)
MAX_TRADE_AMOUNT_DEX=500       # Maximum trade amount for DEX arbitrage (in USDT, usually lower due to gas)
MAX_TRADE_AMOUNT=1000          # Fallback if above not specified (backward compatibility)

GAS_LIMIT=300000
SLIPPAGE_TOLERANCE=0.5
PRICE_IMPACT_THRESHOLD=1.0
MIN_LIQUIDITY_THRESHOLD=50000

# Strategy Parameters
VOLUME_WEIGHT=0.3
LIQUIDITY_WEIGHT=0.4
VOLATILITY_WEIGHT=0.3
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
BOLLINGER_PERIOD=20
BOLLINGER_STD=2

# Monitoring and Alerts
# Telegram Bot (Recommended for real-time alerts)
# Get bot token from @BotFather on Telegram
# Get chat ID from https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord Webhook (Alternative alert channel)
# Create webhook in Discord server settings
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Email Alerts (via webhook service like SendGrid, Mailgun)
EMAIL_WEBHOOK_URL=
ALERT_EMAIL_TO=your@email.com

# Custom Webhook (for n8n integration or custom alerting)
CUSTOM_WEBHOOK_URL=

# Alert Thresholds
ALERT_MIN_PROFIT=1.0
MIN_GAS_BALANCE_USD=10

# Health Check Configuration
HEALTH_CHECK_INTERVAL=60
MAX_POSITION_SIZE=5000

# Logging Configuration
LOG_DIR=/var/log/arbitrage-bot
LOG_LEVEL=INFO

# Cross-chain Bridge Parameters (OPTIONAL - NOT NEEDED for multi-chain DEX arbitrage)
# Only required if you enable cross-chain arbitrage (not recommended for limited capital)
# Current setup runs independent bots on each chain - no bridges needed!
ACROSS_ROUTER=
SOCKET_ROUTER=
STARGATE_ROUTER=
LAYERZERO_ENDPOINT=

# Gas Price Alerts
MAX_GAS_PRICE_GWEI=100
GAS_PRICE_ALERT_THRESHOLD=150
