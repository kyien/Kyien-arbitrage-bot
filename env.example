# Exchange API Keys
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here

# Blockchain RPC URLs
# IMPORTANT: Use private RPC endpoints for 10-50x faster execution and better rate limits
# Recommended providers:
#   - Alchemy: https://www.alchemy.com/ (best coverage)
#   - Infura: https://www.infura.io/
#   - QuickNode: https://www.quicknode.com/
#   - Ankr: https://www.ankr.com/ (cost-effective)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WSS_URL=wss://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_WSS_URL=wss://arb1.arbitrum.io/ws
OPTIMISM_RPC_URL=https://mainnet.optimism.io
OPTIMISM_WSS_URL=wss://mainnet.optimism.io/ws
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_WSS_URL=wss://bsc-dataseed.binance.org:8443/ws

# Additional chains for cross-chain arbitrage
BASE_RPC_URL=https://mainnet.base.org
BASE_WSS_URL=wss://mainnet.base.org/ws
LINEA_RPC_URL=https://rpc.linea.build
LINEA_WSS_URL=wss://rpc.linea.build
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_WSS_URL=wss://api.avax.network/ext/bc/C/ws
ETHEREUM_RPC_URL=https://eth.rpc.node.provider
ETHEREUM_WSS_URL=wss://eth.rpc.node.provider

# Wallet Configuration
# IMPORTANT: Never commit your private key to version control!
WALLET_ADDRESS=0xYourWalletAddressHere
PRIVATE_KEY=0xYourPrivateKeyHere

# Trading Parameters
MIN_PROFIT_THRESHOLD=0.5
MAX_TRADE_AMOUNT=1000
MAX_POSITION_SIZE=5000
GAS_LIMIT=300000
SLIPPAGE_TOLERANCE=0.5

# Price Impact & Liquidity Settings
PRICE_IMPACT_THRESHOLD=1.0
MIN_LIQUIDITY_THRESHOLD=50000

# Advanced Strategy Parameters
VOLATILITY_WEIGHT=0.3
VOLUME_WEIGHT=0.25
LIQUIDITY_WEIGHT=0.25
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
BOLLINGER_PERIOD=20
BOLLINGER_STD=2

# Gas Price Configuration
MAX_GAS_PRICE_GWEI=100

# Monitoring & Alert Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=your_discord_webhook_url
ALERT_MIN_PROFIT=10.0
HEALTH_CHECK_INTERVAL=60

# Cross-Chain Bridge Configuration (optional, defaults provided)
ACROSS_ROUTER=0x69C5BA5efd8562417396DA065EDf29E6C3cFdAe1
SOCKET_ROUTER=0x3a23F943181408EAC424116Af7b7790c94Cb97a5
STARGATE_ROUTER=0x8731d54E9D02c286767d56ac03e8037C07e01e98
LAYERZERO_ENDPOINT=0x3c2269811836af69497E5F486A85D7316753cf62

