[Unit]
Description=Crypto Arbitrage Bot Service
After=network.target

[Service]
Type=simple
User=your_username
WorkingDirectory=/path/to/crypto-arbitrage-bot
Environment="PATH=/usr/bin:/usr/local/bin"
ExecStart=/usr/bin/python3 /path/to/crypto-arbitrage-bot/arbitrage_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target

